rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function role() {
      return signedIn() && userDoc(request.auth.uid).exists()
        ? userDoc(request.auth.uid).data.role
        : null;
    }

    function isStaff() {
      return role() in ['teacher', 'staff', 'admin'];
    }

    function isStudent() {
      return role() == 'student';
    }

    function isParent() {
      return role() == 'parent';
    }

    function isOwnUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function parentStudentId() {
      return userDoc(request.auth.uid).data.studentUid;
    }

    function isParentOf(studentId) {
      return isParent() && parentStudentId() == studentId;
    }

    // Authorization data is private. Low-privilege student accounts may be created
    // by the client. Parent/staff/admin roles must be provisioned by staff.
    match /users/{userId} {
      allow read: if isOwnUser(userId) || isStaff();
      allow create: if isOwnUser(userId)
                    && request.resource.data.role == 'student';
      allow update: if (isOwnUser(userId)
                        && request.resource.data.role == resource.data.role)
                    || isStaff();
      allow delete: if isStaff();
    }

    match /students/{studentId} {
      allow read: if isStaff() || isOwnUser(studentId) || isParentOf(studentId);
      allow create: if isStaff();
      allow update, delete: if isStaff();

      match /marks/{examType} {
        allow read: if isStaff() || isOwnUser(studentId) || isParentOf(studentId);
        allow write: if isStaff();
      }
    }

    match /parents/{parentId} {
      allow read: if isStaff() || isOwnUser(parentId);
      // Parent profiles are provisioned by staff so a user cannot choose an
      // arbitrary child UID and gain access to that student's records.
      allow create: if isStaff();
      allow update: if isStaff()
                    || (isOwnUser(parentId)
                        && request.resource.data.studentUid == resource.data.studentUid);
      allow delete: if isStaff();
    }

    match /teachers/{teacherId} {
      allow read: if isStaff() || isOwnUser(teacherId);
      allow create, update, delete: if isStaff() && (isOwnUser(teacherId) || role() == 'admin');
    }

    match /unregistered_student_marks/{document} {
      allow read, write: if isStaff();
    }

    match /complaints/{document} {
      allow read, update, delete: if isStaff();
      allow create: if signedIn();
    }

    match /registrations/{document} {
      allow read, update, delete: if isStaff();
      allow create: if signedIn();
    }

    match /study_resources/{document} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /question_paper_blueprints/{document} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /paper_download_logs/{document} {
      allow create: if signedIn();
      allow read, update, delete: if isStaff();
    }

    match /resource_verification_logs/{document} {
      allow create: if signedIn();
      allow read, update, delete: if isStaff();
    }

    match /messages/{document} {
      allow read: if isStaff()
                  || (signedIn() && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid));
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isStaff() || (signedIn() && resource.data.receiverId == request.auth.uid);
      allow delete: if isStaff() || (signedIn() && resource.data.senderId == request.auth.uid);
    }

    match /attendance/{document} {
      allow read: if isStaff()
                  || (isStudent() && resource.data.studentId == request.auth.uid)
                  || isParentOf(resource.data.studentId);
      allow create, update, delete: if isStaff();
    }

    match /homework/{document} {
      allow read: if isStaff()
                  || (isStudent() && resource.data.studentId == request.auth.uid)
                  || isParentOf(resource.data.studentId);
      allow create, update, delete: if isStaff();
    }

    match /notifications/{document} {
      allow read: if isStaff() || (signedIn() && resource.data.receiverId == request.auth.uid);
      allow create: if isStaff();
      allow update: if isStaff() || (signedIn() && resource.data.receiverId == request.auth.uid);
      allow delete: if isStaff();
    }

    match /ptm/{document} {
      allow read: if isStaff()
                  || (isParent() && isParentOf(resource.data.studentId))
                  || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if isStaff();
    }

    // Secure by default: collections not explicitly listed above are denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}