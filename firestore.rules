rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function role() {
      return signedIn() && userDoc(request.auth.uid).exists()
        ? userDoc(request.auth.uid).data.role
        : null;
    }

    function isStaff() {
      return role() in ['teacher', 'staff', 'admin'];
    }

    function isStudent() {
      return role() == 'student';
    }

    function isParent() {
      return role() == 'parent';
    }

    function isOwnUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isParentOf(studentId) {
      return isParent() && userDoc(request.auth.uid).data.studentId == studentId;
    }

    // User profiles contain authorization data and must never be publicly readable.
    // Students/parents may create only their own low-privilege account. Staff/admin
    // accounts must be provisioned by an administrator rather than self-registered.
    match /users/{userId} {
      allow read: if isOwnUser(userId) || isStaff();
      allow create: if isOwnUser(userId)
                    && request.resource.data.role in ['student', 'parent'];
      allow update: if isOwnUser(userId)
                    && request.resource.data.role == resource.data.role
                    || isStaff();
      allow delete: if isStaff();
    }

    // Student records.
    match /students/{studentId} {
      allow read: if isStaff() || isOwnUser(studentId) || isParentOf(studentId);
      allow create: if isStaff();
      allow update, delete: if isStaff();

      match /marks/{examType} {
        allow read: if isStaff() || isOwnUser(studentId) || isParentOf(studentId);
        allow write: if isStaff();
      }
    }

    match /parents/{parentId} {
      allow read: if isStaff() || isOwnUser(parentId);
      allow create: if isOwnUser(parentId) && request.resource.data.role == 'parent';
      allow update: if isOwnUser(parentId) || isStaff();
      allow delete: if isStaff();
    }

    match /teachers/{teacherId} {
      allow read: if isStaff() || isOwnUser(teacherId);
      allow create, update, delete: if isStaff() && (isOwnUser(teacherId) || role() == 'admin');
    }

    // Staff-only operational data.
    match /unregistered_student_marks/{document} {
      allow read, write: if isStaff();
    }

    match /complaints/{document} {
      allow read, update, delete: if isStaff();
      allow create: if signedIn();
    }

    match /registrations/{document} {
      allow read, update, delete: if isStaff();
      allow create: if signedIn();
    }

    // Academic content. Authenticated users may read; staff manage it.
    match /study_resources/{document} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /question_paper_blueprints/{document} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /paper_download_logs/{document} {
      allow create: if signedIn();
      allow read, update, delete: if isStaff();
    }

    match /resource_verification_logs/{document} {
      allow create: if signedIn();
      allow read, update, delete: if isStaff();
    }

    // Personal/communication data.
    match /messages/{document} {
      allow read: if isStaff()
                  || (signedIn() && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid));
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isStaff() || (signedIn() && resource.data.receiverId == request.auth.uid);
      allow delete: if isStaff() || (signedIn() && resource.data.senderId == request.auth.uid);
    }

    match /attendance/{document} {
      allow read: if isStaff()
                  || (isStudent() && resource.data.studentId == request.auth.uid)
                  || (isParentOf(resource.data.studentId));
      allow create, update: if isStaff();
      allow delete: if isStaff();
    }

    match /homework/{document} {
      allow read: if isStaff()
                  || (isStudent() && resource.data.studentId == request.auth.uid)
                  || isParentOf(resource.data.studentId);
      allow create, update, delete: if isStaff();
    }

    match /notifications/{document} {
      allow read: if isStaff() || (signedIn() && resource.data.receiverId == request.auth.uid);
      allow create: if isStaff();
      allow update: if isStaff() || (signedIn() && resource.data.receiverId == request.auth.uid);
      allow delete: if isStaff();
    }

    match /ptm/{document} {
      allow read: if isStaff()
                  || (isParent() && isParentOf(resource.data.studentId))
                  || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if isStaff();
    }

    // Secure by default. Any collection not explicitly listed above is denied.
    // This replaces the previous recursive public-read rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}